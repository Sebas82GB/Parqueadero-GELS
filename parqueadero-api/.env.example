# Node
NODE_ENV=development
PORT=3000

# Orígenes permitidos por el middleware CORS, separados por coma (sin
# espacios o con espacios, se recortan). Vacío o ausente = ningún origen
# cross-origin habilitado. Ajustar a la URL real del frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Debe apuntar a la instancia de docker-compose (servicio "postgres", 5432)
DATABASE_URL=postgresql://parqueadero:change-me@localhost:5432/parqueadero

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

LOG_LEVEL=info

# Datos del establecimiento para el recibo de salida (GET /establecimiento y
# recibo en POST /tickets/:id/salida). LOS VALORES DE ABAJO SON DE EJEMPLO Y
# FICTICIOS: reemplazarlos por los datos y textos legales reales del
# establecimiento antes de operar en producción.
ESTABLECIMIENTO_NOMBRE=Parqueadero Ejemplo S.A.S.
ESTABLECIMIENTO_NIT=900.123.456-7
ESTABLECIMIENTO_DIRECCION="Calle 100 # 15-20"
ESTABLECIMIENTO_TELEFONO=(601) 555-0000
ESTABLECIMIENTO_CIUDAD=Bogotá D.C.
ESTABLECIMIENTO_REGIMEN_TRIBUTARIO=Régimen común (ejemplo)
ESTABLECIMIENTO_NUMERO_RESOLUCION=Resolución DIAN 000000000000 de ejemplo
ESTABLECIMIENTO_TEXTO_RESPONSABILIDAD=El establecimiento no se hace responsable por objetos de valor dejados dentro del vehículo (texto de ejemplo).
ESTABLECIMIENTO_TEXTO_SEGURO=Este parqueadero cuenta con póliza de seguro contra todo riesgo (texto de ejemplo).
ESTABLECIMIENTO_TEXTO_HORARIO=Horario de atención: 6:00 a.m. a 9:00 p.m. todos los días (texto de ejemplo).
ESTABLECIMIENTO_TEXTO_RECLAMOS=Reclamos dentro de las 24 horas siguientes a la salida, presentando este recibo (texto de ejemplo).
